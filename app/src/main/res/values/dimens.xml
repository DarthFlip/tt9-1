<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!--
	All keyboard element text sizes must be in "dp" instead of "sp"
	to ignore the Android text size scale. We can't allow scaling because it breaks the layout.
	-->

	<!-- standard text size for keys -->
	<dimen name="key_text_size">21dp</dimen>

	<!-- Status Bar -->
	<dimen name="status_bar_text_size">17sp</dimen>

	<!-- Main Small -->
	<!-- Suggestion strip item spacing — bumped 6sp → 14sp for Gboard-style breathing room.
	     The old 6sp packed suggestions so tightly they read as one continuous string with
	     pipe dividers; 14sp lets each candidate stand on its own and gives a comfortable
	     tap target between items. -->
	<dimen name="main_small_suggestion_spacing_horizontal">14sp</dimen>

	<dimen name="main_small_main_key_wrapper_height">46dp</dimen> <!-- key height + margin -->
	<dimen name="main_small_main_key_wrapper_extra_height_for_messenger">50dp</dimen> <!-- empirically found the correct amount -->
	<dimen name="main_small_command_palette_height">66dp</dimen>
	<dimen name="main_small_command_palette_key_text_size">18dp</dimen>

	<!-- Preferences, default text size -->
	<dimen name="preview_header_height">52dp</dimen>

	<dimen name="pref_custom_min_height">48dp</dimen>
	<dimen name="pref_custom_spacing_horizontal">16dp</dimen>
	<dimen name="pref_custom_spacing_vertical">12dp</dimen>
	<dimen name="pref_deletable_word_icon_size">32sp</dimen>

	<!-- Preferences, large text size -->
	<dimen name="large_pref_category_spacing_top">30dp</dimen>
	<dimen name="large_pref_category_spacing_bottom">12dp</dimen>

	<dimen name="large_pref_spacing_horizontal">16dp</dimen>
	<dimen name="large_pref_spacing_vertical">18dp</dimen>
	<dimen name="large_pref_text_size">22sp</dimen>
	<dimen name="large_pref_summary_size">19sp</dimen>


	<!-- Numpad -->
	<dimen name="numpad_max_width">9999dp</dimen>
	<dimen name="numpad_status_bar_spacing_top">0dp</dimen>
	<dimen name="numpad_status_bar_spacing_bottom">3dp</dimen>
	<dimen name="numpad_keys_padding_bottom">6dp</dimen>
	<dimen name="numpad_keys_spacing_bottom">9dp</dimen> <!-- padding + headroom for shadows -->

	<dimen name="numpad_key_height">56dp</dimen>
	<dimen name="numpad_key_spacing">3dp</dimen>
	<dimen name="numpad_key_arrow_width">38dp</dimen>
	<dimen name="numpad_key_fn_layout_weight">0.675</dimen>

	<dimen name="numpad_key_overlay_z">666dp</dimen>
	<dimen name="numpad_key_overlay_side_text_size">9dp</dimen>
	<dimen name="numpad_key_overlay_hold_icon_size">15dp</dimen>
	<dimen name="numpad_key_overlay_hold_text_size">13dp</dimen>

	<dimen name="numpad_key_overlay_side_char_spacing">2dp</dimen>
	<dimen name="numpad_key_overlay_side_text_spacing_horizontal">4dp</dimen>
	<dimen name="numpad_key_overlay_hold_icon_spacing_top">1dp</dimen>
	<dimen name="numpad_key_overlay_hold_icon_spacing_right">1dp</dimen>
	<dimen name="numpad_key_overlay_hold_text_spacing_top">2dp</dimen>
	<dimen name="numpad_key_overlay_hold_text_spacing_right">5dp</dimen>

	<dimen name="numpad_suggestion_text_size">17sp</dimen>
	<dimen name="numpad_suggestion_height">40sp</dimen>
	<dimen name="numpad_suggestion_min_width">36sp</dimen>

	<!-- Qwerty on-screen keyboard. 46dp → 58dp → 64dp; the last bump matches Gboard's ~64-68dp
	     tap targets and noticeably improves accuracy on the Schok F1's small display. Tightened
	     inter-key vertical margin (1dp instead of 2dp) routes the extra height into actual
	     touch area rather than empty space. -->
	<dimen name="qwerty_row_height">64dp</dimen>
	<!-- Number row is intentionally shorter than the letter rows — Gboard convention. Lets the
	     keyboard add a useful numeric row without growing too tall on the Schok F1's smallish
	     display. -->
	<dimen name="qwerty_number_row_height">36dp</dimen>
	<dimen name="qwerty_key_text_size">20sp</dimen>
	<dimen name="qwerty_number_text_size">15sp</dimen>
</resources>
